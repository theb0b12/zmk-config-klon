#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp A  &kp Q  &kp W  &kp E  &kp R     &kp T    &kp A            &kp A             &kp Y      &kp U  &kp I      &kp O    &kp P     &kp A
&kp A  &kp A  &kp S  &kp D  &kp F     &kp G    &kp BSPC  &kp A  &kp A  &kp SPACE  &kp H      &kp J  &kp K      &kp L    &kp SEMI  &kp A
       &kp Z  &kp X  &kp C  &kp V     &kp B                                       &kp N      &kp M  &kp COMMA  &kp DOT  &kp FSLH
                            &kp LGUI  &kp RET                                     &kp LSHFT  &kp R
            >;

            sensor-bindings = <&inc_dec_kp A B &inc_dec_kp C D>;
        };
    };
};
